# Legacy Modernization Platform — environment configuration
# Copy this file to .env and fill in your IBM Bob values.
# Never commit .env to source control.

# ── IBM Bob Shell API key (required for all AI features) ─────────────────────
#
# Step 1: Install Bob Shell (if not already installed):
#   Windows:  powershell -ep Bypass 'irm -Uri "https://bob.ibm.com/download/bobshell.ps1" | iex'
#   macOS/Linux: curl -fsSL https://bob.ibm.com/download/bobshell.sh | bash
#
# Step 2: Log in at https://bob.ibm.com
# Step 3: Navigate to your subscription instance → API Keys
# Step 4: Create a new key with Scope = "Inference"
#         (An Inference-scoped key is tied to a specific subscription instance
#          and team; no additional instance or team headers are required.)
# Step 5: Set the key value below.
#
# Bob Shell reads this automatically as BOBSHELL_API_KEY.
# The platform also reads it to report configuration status.
BOBSHELL_API_KEY=

# Optional: Bob subscription instance ID and team ID.
# Only needed if your subscription requires explicit routing.
# BOB_INSTANCE_ID=
# BOB_TEAM_ID=

# ── Optional application settings ────────────────────────────────────────────
# DEBUG=false
